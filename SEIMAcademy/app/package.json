{
  "name": "seim-academy-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "SEIM-Academy app shell — static-first SPA, Preact + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run check:contrast && npm run check:types && tsc --noEmit && npm test",
    "predev": "node scripts/sync-content.mjs && node scripts/make-icons.mjs",
    "prebuild": "node scripts/sync-content.mjs && node scripts/make-icons.mjs",
    "sync:content": "node scripts/sync-content.mjs",
    "check:types": "node scripts/check-types.mjs",
    "test": "node scripts/run-tests.mjs",
    "make:icons": "node scripts/make-icons.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "verify": "npm run check && npm run build && npm run check:pwa"
  },
  "dependencies": {
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.3",
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
