{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/voltron-1/SEIM-Academy/SEIMAcademy/schema/app-data-schema.json",
  "title": "SEIM-Academy content schema 1.0.0",
  "description": "Machine-readable mirror of app-data-schema.md. That document is normative; where the two disagree, this file is the bug. Structural invariants that JSON Schema cannot express (6.1 lesson-time-budget, 6.4 instructions-precede-exercise, 6.5 srs-anti-flood, 6.6 requires-subset-of-teaches, 6.8 deterministic-ids, 6.9 no-timestamps, 6.10 no-executable-content) are enforced by scripts/validate-content.mjs.",
  "$defs": {
    "schemaVersion": { "const": "1.0.0" },
    "tag": {
      "type": "string",
      "pattern": "^(corpus|channel|event|provider|concept|lifecycle):[a-z0-9][a-z0-9:._-]*$"
    },
    "tags": { "type": "array", "items": { "$ref": "#/$defs/tag" }, "uniqueItems": true },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 120 },
    "lifecycleStage": {
      "enum": ["preparation", "identification", "containment", "eradication", "recovery", "lessons-learned"]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
        "heading": { "type": "string", "maxLength": 200 },
        "lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2, "maxItems": 2
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generator": { "const": "build-content" },
        "generator_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "source_repo": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "source_license": { "type": "string" },
        "profile": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["generator", "generator_version", "source_repo", "source_commit", "source_license", "profile", "content_hash"],
      "additionalProperties": false
    },
    "srs": {
      "type": "object",
      "properties": {
        "eligible": { "type": "boolean" },
        "deck": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["eligible", "deck", "reason"],
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": { "enum": ["predict", "reading", "flashcard", "quiz", "instructions", "exercise", "scenario", "capstone-step"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "body": { "type": "string" },
        "source": { "$ref": "#/$defs/source" },
        "teaches": { "$ref": "#/$defs/tags" },
        "requires": { "$ref": "#/$defs/tags" },
        "estimated_seconds": { "type": "integer", "minimum": 5, "maximum": 180 },
        "difficulty": { "enum": ["intro", "standard", "step-up"] },
        "lifecycle_stage": { "$ref": "#/$defs/lifecycleStage" },
        "graded": { "type": "boolean" },
        "srs": { "$ref": "#/$defs/srs" },
        "payload": { "type": "object" }
      },
      "required": ["id", "type", "title", "body", "source", "estimated_seconds", "graded", "payload"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["reading", "flashcard", "instructions"] } }, "required": ["type"] },
          "then": { "required": ["teaches"], "properties": { "teaches": { "minItems": 1 } } },
          "else": { "not": { "required": ["teaches"] } }
        },
        {
          "if": { "properties": { "type": { "const": "exercise" } }, "required": ["type"] },
          "then": {
            "required": ["requires", "difficulty"],
            "properties": { "requires": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "predict" } }, "required": ["type"] },
          "then": { "properties": { "graded": { "const": false } }, "not": { "required": ["requires"] } }
        },
        {
          "if": { "properties": { "type": { "const": "flashcard" } }, "required": ["type"] },
          "then": { "required": ["srs"] },
          "else": { "not": { "required": ["srs"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["reading", "flashcard", "instructions", "predict"] } }, "required": ["type"] },
          "then": { "not": { "required": ["difficulty"] } }
        }
      ]
    },
    "lesson": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "type": "string", "pattern": "^t[12]-m[0-9]{2}[a-z]?-[a-z0-9-]+$" },
        "tier": { "enum": [1, 2] },
        "module": { "type": "string", "pattern": "^[0-9]+[a-z]?$" },
        "part": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "estimated_seconds": { "type": "integer", "minimum": 180, "maximum": 420 },
        "teaches": { "$ref": "#/$defs/tags" },
        "requires": { "$ref": "#/$defs/tags" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" }, "minItems": 1 },
        "generated": { "$ref": "#/$defs/provenance" },
        "atoms": { "type": "array", "items": { "$ref": "#/$defs/atom" }, "minItems": 1, "maxItems": 24 }
      },
      "required": ["schema_version", "id", "tier", "module", "title", "summary", "estimated_seconds", "teaches", "requires", "sources", "generated", "atoms"],
      "additionalProperties": false
    },
    "exerciseDataSet": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "const": "action-event-pairs" },
        "parse_only": { "const": true },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "type": "string", "minLength": 1, "maxLength": 160 },
              "channel": { "type": "string", "minLength": 1 },
              "event_ids": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
              "scope": { "enum": ["dc", "target-system"] },
              "source": { "$ref": "#/$defs/source" }
            },
            "required": ["action", "channel", "event_ids", "source"],
            "additionalProperties": false
          }
        },
        "generated": { "$ref": "#/$defs/provenance" }
      },
      "required": ["schema_version", "id", "kind", "parse_only", "pairs", "generated"],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/lesson" },
    { "$ref": "#/$defs/exerciseDataSet" }
  ]
}
